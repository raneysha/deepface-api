# --- Database (read by deepface for its embeddings table, and by this app for users/photographers/uploads) ---
DEEPFACE_POSTGRES_URI=postgresql://deepface:deepface@localhost:5432/deepface

# --- Auth ---
# REQUIRED: 32+ random characters. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480
IMAGE_URL_MINUTES=15
# Set to true when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false
# Public sign-up creates client accounts only. Set false to make accounts admin-created only.
ALLOW_SIGNUP=true

# --- Face recognition ---
FACE_DB_TYPE=postgres
FACE_MODEL=Facenet
FACE_DETECTOR=opencv

# --- Storage (local development only: do NOT copy these two into Railway, the Dockerfile sets them to the volume) ---
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=10          # raise for large camera files (per image)
FACE_WORKERS=1            # concurrent face jobs; each can use ~0.5 GB extra, so raise only with more memory
FACE_MAX_SIDE=1600        # photos are shrunk to this (longest side) for face detection; the stored original is untouched

# Database connection pool (keep small: hosted poolers allow few connections)
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
