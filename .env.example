# Read by deepface for the postgres backend (verify the exact variable name in
# the deepface repo's database/postgres code for your installed version)
DEEPFACE_POSTGRES_URI=postgresql://deepface:deepface@localhost:5432/deepface

# Read by this service
FACE_DB_TYPE=postgres
FACE_MODEL=Facenet
FACE_DETECTOR=opencv
API_KEY=change-me

# Where original photos + thumbnails are stored (back this up / mount a volume in production)
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=10
